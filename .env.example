# ==============================================================================
# ZenBot Environment Configuration
# ==============================================================================

# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Channel Lock (Optional: leave blank to allow across allowed channels/DMs)
CHANNEL_ID=

# Security: Allowed Discord User IDs (comma-separated). Leave blank to allow anyone.
DISCORD_ALLOWED_USER_IDS=

# Active AI Provider: "groq" or "gemini"
DEFAULT_PROVIDER=groq

# ------------------------------------------------------------------------------
# Provider 1: Groq (Ultra-fast, generous free tier)
# https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1500
GROQ_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# Provider 2: Google AI Studio / Gemini (Deep reasoning & long context)
# https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# ------------------------------------------------------------------------------
# Persona & Humor Intensity Setting
# 0 = completely serious
# 1 = occasional dry remark
# 2 = naturally humorous (Default)
# 3 = frequently playful
# 4 = shitpost territory
# 5 = absolute Discord degeneracy
# ------------------------------------------------------------------------------
HUMOR_INTENSITY=2

