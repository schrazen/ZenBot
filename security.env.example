# ============================================================================
# ZENBOT HIGH-SECURITY OWNER & PERSONAL VAULT LOCK (security.env.example)
# ============================================================================
# Copy this file to security.env and set your exact Discord User ID and
# Discord Username. File, Vault, and command access are strictly locked
# (fail-closed) to this single account in private DMs only.
# ============================================================================

VAULT_OWNER_DISCORD_ID=YOUR_DISCORD_USER_ID
VAULT_OWNER_DISCORD_USERNAME=your_discord_username
VAULT_REQUIRE_DM_ONLY=true
VAULT_ALLOWED_DIRS=Documents,Downloads,Desktop
